# Firebase Web-Config — Werte aus Firebase Console > Projekteinstellungen > Allgemein > Web-App
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Namespace dieses Lernsets — alle Firestore-Pfade liegen unter abstimmungen/<UNIT_ID>/
NEXT_PUBLIC_UNIT_ID=ki26

# ── Server-only (Lehrer-Tier via Next.js Route Handlers + Firebase Admin SDK) ──
# Vollständiges Service-Account-JSON als String (roh ODER Base64-kodiert).
# Generieren: Firebase Console > Projekteinstellungen > Dienstkonten >
# "Neuen privaten Schlüssel generieren". NIEMALS committen.
# In Vercel als Environment Variable hinterlegen (Production + Preview).
#
# WICHTIG: MUSS eine einzige Zeile sein (kein mehrzeiliges JSON).
# Next.js liest .env.local zeilenweise — mehrzeiliger Wert wird abgeschnitten.
# Empfohlen: Base64-kodieren (kein Whitespace-Problem):
#   base64 -w0 service-account.json   (Git-Bash / WSL)
# ODER: JSON minifizieren (alles in eine Zeile):
#   python -c "import json,sys; print(json.dumps(json.load(open('service-account.json')),separators=(',',':')))"
FIREBASE_SERVICE_ACCOUNT=

# ── Server-only (Orakel, Lernseite 2 / Thema 04) ──────────────────────────────
# Anthropic-API-Schlüssel für den Orakel-Kommentar (claude-haiku-4-5,
# günstigstes Modell; Antwort wird in Firestore gecacht — sehr geringe Kosten).
# Erzeugen: https://platform.claude.com → API Keys. NIEMALS committen.
# In Vercel als Environment Variable hinterlegen (Production + Preview).
# Ohne Schlüssel läuft alles weiter — das Orakel meldet dann freundlich,
# dass es noch schweigt.
ANTHROPIC_API_KEY=

# ── Server-only (Korrektorat-Editor, /korrektorat) ────────────────────────────
# Externer Editor, mit dem eine Korrekturperson die Lerntexte korrigiert, ohne
# Repo-Zugriff. Jede Speicherung wird ein Commit auf KORREKTORAT_BRANCH, daraus
# wächst ein Pull Request. Ablauf und Wartung: docs/KORREKTORAT.md.
#
# Passwort, das der Korrektorin/dem Korrektor mitgeteilt wird (sicherer Kanal).
KORREKTORAT_PASSCODE=
# HMAC-Schlüssel für das Sitzungs-Cookie. Erzeugen:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KORREKTORAT_SESSION_SECRET=
# Fine-grained GitHub-PAT auf dieses Repo: Contents R/W, Pull Requests R/W.
# Läuft nach höchstens einem Jahr ab — Termin setzen. NIEMALS committen.
KORREKTORAT_GITHUB_TOKEN=
# Optional, mit diesen Vorgaben:
#   KORREKTORAT_REPO=hep-impuls/ki
#   KORREKTORAT_BASIS_BRANCH=main
#   KORREKTORAT_BRANCH=korrektorat/runde-1     ← pro Korrekturrunde hochzählen
#
# Nur für die lokale Vorschau: liest das Arbeitsverzeichnis statt GitHub,
# braucht kein Token, Speichern ist gesperrt.
#   KORREKTORAT_QUELLE=lokal
